{
  "version": "0.2",
  "language": "en",
  "enableGlobDot": true,
  "ignorePaths": [
    "node_modules/**",
    ".git/**",
    "*.lock",
    "package-lock.json"
  ],
  "dictionaries": ["en_US", "softwareTerms", "filetypes", "misc"],
  "words": [
    "imgdedup",
    "dedup",
    "deduplication",
    "perceptual",
    "PRDs",
    "ADRs",
    "MADR",
    "Dependabot",
    "dependabot",
    "commitlint",
    "markdownlint",
    "lychee",
    "lycheeverse",
    "cspell",
    "typos",
    "semver",
    "semantic",
    "changelog",
    "Conventional",
    "trunk",
    "rebase",
    "kebab",
    "linter",
    "linters",
    "toolchain",
    "CodeQL",
    "gitleaks",
    "EXIF",
    "JPEG",
    "webp",
    "subagent",
    "subagents",
    "YAGNI",
    "repo",
    "repos",
    "frontmatter",
    "macos",
    "darwin",
    "intruder",
    "SDLC",
    "Resumability",
    "resumable",
    "parallelizable",
    "untrusted",
    "underspecified"
  ],
  "ignoreRegExpList": [
    "/\\]\\([^)]*\\)/",
    "/`[^`]*`/"
  ]
}
