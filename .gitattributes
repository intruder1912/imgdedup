# Normalize line endings: text files are LF in the repo.
* text=auto eol=lf

# Explicitly binary (no EOL conversion / no diff noise)
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.pdf binary
*.zip binary
*.gz binary

# Treat lockfiles as generated in diffs/reviews
*.lock linguist-generated=true
package-lock.json linguist-generated=true
