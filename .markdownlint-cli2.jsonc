{
  // markdownlint-cli2 configuration. Rules tuned for prose-heavy project docs.
  "config": {
    "default": true,
    "MD013": false, // line length — prose wraps naturally; not enforced
    "MD033": false, // allow inline HTML where needed
    "MD040": false, // allow fenced code blocks without a language (ASCII diagrams)
    "MD041": false, // first line need not be a top-level heading (templates)
    "MD024": { "siblings_only": true }, // duplicate headings ok if not siblings
    "MD026": false, // allow trailing punctuation in headings
    "MD036": false, // allow emphasis used as pseudo-heading
    "MD060": false  // table pipe spacing/alignment style not enforced
  },
  "globs": ["**/*.md"],
  "ignores": ["node_modules", ".git"]
}
